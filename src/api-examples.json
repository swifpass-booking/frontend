  "6_payment_webhook": {
    "endpoint": "POST /v1/webhooks/psp/esewa",
    "note": "Signature verified with the PSP's shared secret before any state change. Handler must be idempotent — PSPs retry.",
    "request": {
      "event": "payment.captured",
      "pspRef": "ESW-2026-0819-77341",
      "paymentId": "pay_01K3M9UB55",
      "amountMinor": 1585500,
      "currency": "NPR",
      "signature": "sha256=6f2c...",
      "occurredAt": "2026-08-19T10:33:02Z"
    },
    "effect": [
      "payments.status -> 'captured'",
      "for each booking_item: call provider adapter to confirm; on success set status='confirmed', store providerRef",
      "seat_allocations.state 'held' -> 'sold'",
      "issue one ticket per passenger per confirmed booking_item",
      "if any item fails: booking.status='partially_failed', auto-refund that item's subtotal, notify user"
    ]
  },

