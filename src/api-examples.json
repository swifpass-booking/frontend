  "8_ticket_credential": {
    "endpoint": "GET /v1/tickets/tkt_01K3M9V101/credential?deviceId=dev_01K3M7ZZ01",
    "note": "rotationSecret is returned ONCE. The app writes it to Keychain/Keystore and never sends it back.",
    "response": {
      "ticketId": "tkt_01K3M9V101",
      "credential": "SWP1.eyJhbGciOiJFZDI1NTE5Iiwia2lkIjoiaV8yMDI2XzA4In0.eyJ2IjoxLCJ0aWQiOiJ0a3RfMDFLM005VjEwMSJ9.MEUCIQDx3k...",
      "kid": "k_2026_08",
      "rotationIntervalSeconds": 30,
      "rotationSecret": "sN7pQ2vX9kLm3bT8wR1yF4hJ6dG0aZcE"
    },
    "decoded_credential_body": {
      "v": 1,
      "tid": "tkt_01K3M9V101",
      "bid": "bkg_01K3M9U9XY",
      "occ": "occ_01K3M8YHQ2ZZ",
      "zone": "ECON",
      "seat": "12A",
      "pax": "SHRESTHA/SAGAR",
      "dpk": "MCowBQYDK2VwAyEA9k2f...",
      "nbf": 1789700100,
      "exp": 1789786500,
      "kid": "k_2026_08"
    },
    "qr_payload_actually_displayed": {
      "format": "<credential>|<rotationProof>",
      "rotationProof": {
        "ctr": 41,
        "ts": 1789786412,
        "sig": "base64url(Ed25519_sign(devicePrivateKey, tid || ctr || ts))"
      },
      "explanation": "The long-lived part proves the server sold this ticket. The short-lived part proves this phone is holding it right now. A screenshot carries the first but not the second, so it fails after one 30s window."
    }
  },

