  "10_scan_offline_then_sync": {
    "offline_decision_on_device": {
      "input": "scanned QR string",
      "checks_in_order": [
        "parse SWP1 envelope",
        "look up kid in cached signingKeys -> else reject 'unknown_key'",
        "verify server Ed25519 signature -> else reject 'bad_signature'",
        "check nbf <= now <= exp -> else reject 'expired_window' / 'not_yet_valid'",
        "check occ matches this session's occurrenceId -> else reject 'wrong_occurrence'",
        "verify rotationProof.sig against dpk, |now - ts| <= 60s -> else reject 'device_proof_invalid'",
        "check tid not in local redeemed-set and not in manifest.revoked -> else reject 'already_redeemed' / 'revoked'",
        "append to local redeemed-set, return accepted"
      ],
      "target": "under 2000 ms per scan, no network"
    },
    "endpoint": "POST /v1/scan/redemptions:sync",
    "request": {
      "scanSessionId": "ssn_01K3M9W201",
      "redemptions": [
        { "ticketId": "tkt_01K3M9V101", "accepted": true,  "rejectReason": null,              "rotationCounter": 41, "scannedAt": "2026-09-14T00:52:11Z", "deviceSignature": "MEUCIQC..." },
        { "ticketId": "tkt_01K3M9V102", "accepted": true,  "rejectReason": null,              "rotationCounter": 12, "scannedAt": "2026-09-14T00:52:40Z", "deviceSignature": "MEQCIGx..." },
        { "ticketId": "tkt_01K3M9V101", "accepted": false, "rejectReason": "already_redeemed","rotationCounter": 44, "scannedAt": "2026-09-14T00:58:03Z", "deviceSignature": "MEYCIQD..." }
      ]
    },
    "response": {
      "accepted": 2,
      "duplicates": [
        { "ticketId": "tkt_01K3M9V101", "conflictingDeviceIds": ["scn_01K3M6AA01", "scn_01K3M6AA02"] }
      ],
      "rejected": []
    },
    "duplicate_policy": "Earliest scannedAt wins and stays admitted. Later ones are flagged is_duplicate=true and raised as an incident on the operator console — the person was already through the gate, so the record is for investigation, not enforcement."
  },

