    { "id": "TS-06", "name": "Offline double entry",       "setup": "Same ticket scanned on scn_...AA01 and scn_...AA02 while both offline", "expected": "both admit locally; sync flags is_duplicate and raises an incident" },
    { "id": "TS-07", "name": "Agent tries to pay",         "setup": "Model emits a tool call named 'checkout'",                      "expected": "rejected — not in AGENT_TOOL_ALLOWLIST; logged; unauthorised-action counter stays 0" },
