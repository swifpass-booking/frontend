# Websocket upgrade for /agent/ws/voice; plain requests keep a normal connection.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${PORT};
    root /usr/share/nginx/html;
    client_max_body_size 4m;  # voice clips go to /agent/stt

    include /etc/nginx/snippets/security-headers.conf;

    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_read_timeout 60s;
    }

    # The agent's routes have no /agent prefix of their own (same as next.config.ts in dev).
    # Only the voice socket may sit idle for long; ordinary requests give up after 75s.
    location /agent/ws/ {
        proxy_pass ${AGENT_UPSTREAM}/ws/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;  # idle voice calls stay open
    }

    location /agent/ {
        proxy_pass ${AGENT_UPSTREAM}/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 150s;
    }

    # Next's hashed build output never changes under the same name.
    location /_next/static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;  # add_header in a location drops the server-level ones
    }

    # Voice-activity model and its wasm runtime. The runtime's .mjs must be served as JavaScript or browsers refuse to import it.
    location /vad/ {
        types {
            application/javascript js mjs;
            application/wasm wasm;
            application/octet-stream onnx;
        }
        expires 7d;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Static export: /tickets is tickets.html, /payment/stripe/sim is payment/stripe/sim.html.
    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }
}
