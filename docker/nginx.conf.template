server {
    listen ${PORT};
    root /usr/share/nginx/html;
    client_max_body_size 4m;  # voice clips go to /agent/stt

    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_read_timeout 60s;
    }

    # The agent's routes have no /agent prefix of their own (same as vite.config.ts).
    location /agent/ {
        proxy_pass ${AGENT_UPSTREAM}/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_read_timeout 120s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Client-side routes (/ops, /admin, /payment/return, ...) all load the SPA.
    location / {
        try_files $uri /index.html;
    }
}
