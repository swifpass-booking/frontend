# Websocket upgrade for /agent/ws/voice; plain requests keep a normal connection.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${PORT};
    root /usr/share/nginx/html;
    client_max_body_size 4m;  # voice clips go to /agent/stt

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_read_timeout 60s;
    }

    # The agent's routes have no /agent prefix of their own (same as vite.config.ts).
    # Only the voice socket may sit idle for long; ordinary requests give up after 75s.
    location /agent/ws/ {
        proxy_pass ${AGENT_UPSTREAM}/ws/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;  # idle voice calls stay open
    }

    location /agent/ {
        proxy_pass ${AGENT_UPSTREAM}/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 75s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;  # add_header in a location drops the server-level ones
    }

    # Client-side routes (/ops, /admin, /payment/return, ...) all load the SPA.
    location / {
        try_files $uri /index.html;
    }
}
